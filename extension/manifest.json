{
  "manifest_version": 3,
  "name": "Smart Filler",
  "version": "1.2.0",
  "description": "Context-aware form filler powered by AI for developers, testers, and power users.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "commands",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.vercel.app/*",
    "https://api.groq.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Smart Filler Form Assistant"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Fill current active form with Smart Filler"
    },
    "fill-single-input": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "mac": "Alt+Shift+I"
      },
      "description": "Fill currently focused input field only"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": [
        "content/formScanner.js",
        "content/formFiller.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
