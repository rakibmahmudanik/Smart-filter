GROQ_API_KEY=your_groq_api_key_here
ACCESS_KEY=your_secret_access_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Port for local development
PORT=3000

# Groq Cloud API Key (Get free from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Secret token shared between extension and server (Generate any long random string)
EXTENSION_TOKEN=smartfill_secure_token_replace_with_random_string

# Default Groq Model
MODEL=llama-3.3-70b-versatile

# Comma-separated allowed origins (Replace <EXTENSION_ID> after loading in chrome)
ALLOWED_ORIGINS=chrome-extension://*